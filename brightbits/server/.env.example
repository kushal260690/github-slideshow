# Copy to .env (or set in your host's dashboard). Everything is optional in development.
PORT=8787
# Public URL of the app, used for Stripe redirect URLs.
APP_URL=http://localhost:8787
# SQLite file. Use a persistent volume in production.
DATABASE_PATH=./data/brightbits.db
NODE_ENV=development

# Stripe (https://dashboard.stripe.com/test/apikeys). Leave empty to use demo billing locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs for each plan (create them under Products in the Stripe dashboard).
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_QUARTER=
STRIPE_PRICE_MONTH=
# Days of free trial on new subscriptions.
TRIAL_DAYS=7

# Demo billing (instant Pro with no payment) is on when Stripe isn't configured,
# except in production where it needs this explicit opt-in.
ALLOW_DEMO_BILLING=
